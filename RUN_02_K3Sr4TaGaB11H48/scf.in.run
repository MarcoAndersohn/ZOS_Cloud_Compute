&CONTROL
 restart_mode='restart',
 wf_collect=.true.,
 disk_io='low',
 
 nstep = 100,
  calculation = 'vc-relax'
  prefix = 'K3Sr4TaGaB11H48'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 68
  ntyp = 6
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  smearing='m-v'
  degauss = 0.02
/
&ELECTRONS
 mixing_beta = 0.7,
 electron_maxstep = 150,
 mixing_mode='plain',
 mixing_ndim = 3,
 diagonalization='cg',
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
