&CONTROL
  calculation = 'vc-relax'
  prefix = 'HfTh3TiH38'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 36
  ntyp = 4
  ecutwfc = 80.0
  ecutrho = 800.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
 electron_maxstep = 150,
 mixing_mode='local-TF',
 diago_david_ndim = 4,
 mixing_ndim = 4,
 diagonalization='cg',
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
