&CONTROL
  calculation = 'vc-relax'
  prefix = 'TaTiH6Ru'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 9
  ntyp = 4
  ecutwfc = 80.0
  ecutrho = 800.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
 electron_maxstep = 150,
 mixing_mode='local-TF',
 diago_david_ndim = 4,
 mixing_ndim = 4,
 diagonalization='cg',
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
ATOMIC_SPECIES
  H  1.00  H.UPF
  Ru  1.00  Ru.UPF
  Ta  1.00  Ta.UPF
  Ti  1.00  Ti.UPF
ATOMIC_POSITIONS (angstrom)
  Ta  4.807595  4.807595  4.807592
  Ti  1.602532  1.602532  1.602531
  H  3.205063  3.205063  4.689229
  H  3.205063  1.720896  3.205062
  H  1.720895  3.205063  3.205062
  H  3.205063  3.205064  1.720894
  H  3.205063  4.689231  3.205061
  H  4.689231  3.205063  3.205062
  Ru  -0.000000  0.000000  -0.000000
K_POINTS automatic
  2 2 2 0 0 0
CELL_PARAMETERS (angstrom)
  3.205063  3.205063  -0.000000
  0.000000  3.205063  3.205062
  3.205063  0.000000  3.205062

! SMART_OOM_LEVEL=0
