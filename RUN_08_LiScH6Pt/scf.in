&CONTROL
 disk_io='low',
  calculation = 'vc-relax'
  prefix = 'LiScH6Pt'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
 nosym=.true.,
  ibrav = 0
  nat = 9
  ntyp = 4
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
 mixing_beta = 0.4,
 mixing_mode='local-TF',
 diago_david_ndim = 2,
 electron_maxstep = 150,
 mixing_ndim = 2,
 diagonalization='cg',
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
ATOMIC_SPECIES
  H  1.00  H.UPF
  Li  1.00  Li.UPF
  Pt  1.00  Pt.UPF
  Sc  1.00  Sc.UPF
ATOMIC_POSITIONS (angstrom)
  Li  4.926435  4.926436  4.926437
  Sc  1.642145  1.642145  1.642146
  H  3.284290  3.284290  4.909122
  H  3.284290  1.659460  3.284291
  H  1.659460  3.284290  3.284291
  H  3.284290  3.284291  1.659460
  H  3.284290  4.909121  3.284291
  H  4.909120  3.284291  3.284291
  Pt  0.000000  0.000000  -0.000000
K_POINTS automatic
  2 2 2 0 0 0
CELL_PARAMETERS (angstrom)
  0.000000  3.284290  3.284291
  3.284290  0.000000  3.284291
  3.284290  3.284291  -0.000000

! SMART_OOM_LEVEL=4
