&CONTROL
  calculation = 'vc-relax'
  prefix = 'SrH3'
  outdir = './tmp/'
 pseudo_dir = 'C:/Users/Acer/Desktop/Quantum_Espresso/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
