&CONTROL
 restart_mode='from_scratch',
  calculation = 'vc-relax'
  prefix = 'K4SrLi2AlH12'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 20
  ntyp = 5
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
 electron_maxstep = 150,
 mixing_ndim = 8,
 diagonalization='david',
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
ATOMIC_SPECIES
  Al  1.00  Al.UPF
  H  1.00  H.UPF
  K  1.00  K.UPF
  Li  1.00  Li.UPF
  Sr  1.00  Sr.UPF
