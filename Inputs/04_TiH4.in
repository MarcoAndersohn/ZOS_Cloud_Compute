&CONTROL
  calculation = 'vc-relax'
  prefix = 'TiH4'
  outdir = './tmp/'
 pseudo_dir = 'C:/Users/Acer/Desktop/Quantum_Espresso/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 2
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
 electron_maxstep = 300,
 mixing_ndim = 12,
 mixing_beta = 0.4,
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
ATOMIC_SPECIES
  H  1.00  H.UPF
  Ti  1.00  Ti.UPF
ATOMIC_POSITIONS (angstrom)
  Ti  -0.000000  -0.000000  -0.000000
  H  1.034116  1.034116  1.034116
  H  1.034116  1.034116  -1.034116
  H  1.034116  -1.034116  1.034116
  H  -1.034116  1.034116  1.034116
K_POINTS automatic
  2 2 2 0 0 0
CELL_PARAMETERS (angstrom)
  -2.068232  2.068232  2.068232
  2.068232  -2.068232  2.068232
  2.068232  2.068232  -2.068232
