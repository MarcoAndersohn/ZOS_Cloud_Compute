&CONTROL
  calculation = 'vc-relax'
  prefix = 'Li2MgZrH6'
  outdir = './tmp/'
  pseudo_dir='/home/marco/ZOS_Cloud_Compute/pseudo/'
  forc_conv_thr = 1.0d-3
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 10
  ntyp = 4
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'methfessel-paxton'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-6
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
/
ATOMIC_SPECIES
  H  1.00  H.UPF
  Li  1.00  Li.UPF
  Mg  1.00  Mg.UPF
  Zr  1.00  Zr.UPF
ATOMIC_POSITIONS (angstrom)
  Li  1.473742  1.011990  2.776496
  Li  4.172781  2.865366  7.861422
  Mg  5.447266  3.740530  10.262523
  Zr  2.760334  1.895467  5.200406
  H  1.305819  2.606181  4.032098
  H  3.368848  1.497850  3.341028
  H  1.713719  0.282747  4.662443
  H  3.937065  0.367954  5.762462
  H  3.787915  3.542271  4.684640
  H  1.265090  2.263079  6.489981
K_POINTS automatic
  2 2 2 0 0 0
CELL_PARAMETERS (angstrom)
